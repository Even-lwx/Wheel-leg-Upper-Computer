<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/colorBackgroundLight">

    <!-- 蓝牙控制区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_control_panel"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="蓝牙开关"
            android:textSize="16sp"
            android:textColor="@color/colorTextDark"
            android:layout_marginEnd="12dp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/switch_bluetooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="@color/colorPrimary"
            android:trackTint="@color/colorPrimaryLight" />

        <Button
            android:id="@+id/btn_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="搜索设备"
            android:textSize="14sp"
            android:background="@drawable/bg_button_primary"
            android:textColor="@color/colorTextLight"
            android:elevation="2dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="断开连接"
            android:textSize="14sp"
            android:background="@drawable/bg_button_error"
            android:textColor="@color/colorTextLight"
            android:elevation="2dp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 状态显示 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态：蓝牙未连接"
        android:textSize="15sp"
        android:padding="14dp"
        android:background="@drawable/bg_status_bar"
        android:textColor="@color/colorTextLight"
        android:gravity="center"
        android:elevation="3dp"
        android:layout_marginTop="12dp"
        android:textStyle="bold" />

    <!-- 设备列表区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <!-- 已配对设备 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已配对设备"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextLight"
                android:padding="12dp"
                android:gravity="center"
                android:background="@drawable/bg_status_bar" />

            <ListView
                android:id="@+id/list_paired"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:padding="8dp" />

        </LinearLayout>

        <!-- 发现的设备 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card_rounded"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发现的设备"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextLight"
                android:padding="12dp"
                android:gravity="center"
                android:background="@drawable/bg_status_bar" />

            <ListView
                android:id="@+id/list_found"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 遥控控制区域 - 紧凑布局 -->
    <LinearLayout
        android:id="@+id/layout_remote_control"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_rounded"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_bar"
            android:gravity="center"
            android:padding="8dp"
            android:text="遥控控制"
            android:textColor="@color/colorTextLight"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="2dp" />

        <!-- 前进按钮 -->
        <Button
            android:id="@+id/btn_forward"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:text="↑ 前进"
            android:textColor="@color/colorTextLight"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 左右和停止按钮行 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_left"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_primary"
                android:elevation="4dp"
                android:text="← 左转"
                android:textColor="@color/colorTextLight"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_error"
                android:elevation="4dp"
                android:text="停止"
                android:textColor="@color/colorTextLight"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_primary"
                android:elevation="4dp"
                android:text="右转 →"
                android:textColor="@color/colorTextLight"
                android:textSize="13sp"
                android:textStyle="bold" />
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 后退按钮 -->
        <Button
            android:id="@+id/btn_backward"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:text="↓ 后退"
            android:textColor="@color/colorTextLight"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>